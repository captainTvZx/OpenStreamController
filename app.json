{
  "expo": {
    "name": "OpenStreamController",
    "slug": "OpenStreamController",
    "version": "1.0.0",
    "scheme": "openstreamcontroller",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B0D12"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B0D12"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openstreamcontroller.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "OpenStreamController needs local network access to find and control OBS on computers connected to your Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.openstreamcontroller.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenStreamController uses the camera only to read the connect QR code shown by OBS.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
